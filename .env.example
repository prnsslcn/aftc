# ─────────────────────────────────────────
# aftc 환경변수 예시
# 실제 값은 .env.local 에 저장 (git 무시)
# Vercel Postgres/Blob 값은 `vercel env pull .env.local` 로 자동 채워짐.
# SESSION_SECRET 만 별도로 생성 필요.
# ─────────────────────────────────────────

# Vercel Postgres (Neon 통합) — `vercel env pull` 시 자동 주입
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Vercel Blob — `vercel env pull` 시 자동 주입
BLOB_READ_WRITE_TOKEN=

# 관리자 세션 JWT 서명 시크릿 (HS256, 64자 hex 권장)
# 생성 예: `openssl rand -hex 32`
SESSION_SECRET=
